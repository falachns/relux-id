{
  "$schema": "https://relux.kai.id/schema/component.json",
  "name": "Toggle (Switch)",
  "slug": "toggles",
  "version": "1.0.0",
  "status": "stable",
  "category": "Form Controls",
  "description": "Kontrol dwikeadaan aktif/nonaktif untuk preferensi atau setelan.",
  "figma": {
    "file": "Design System KAI v.1",
    "node": "124:4890"
  },
  "packages": {
    "blade": "kai/relux-ui",
    "react": "@kai/relux-react",
    "angular": "@kai/relux-angular",
    "css": "@kai/relux-css"
  },
  "dependencies": [
    "@kai/relux-css"
  ],
  "props": [
    {
      "name": "checked",
      "type": "boolean",
      "default": "false"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false"
    },
    {
      "name": "label",
      "type": "string",
      "default": "-"
    }
  ],
  "variants": [
    "default",
    "checked",
    "disabled"
  ]
}