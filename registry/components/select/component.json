{
  "$schema": "https://relux.kai.id/schema/component.json",
  "name": "Select (Dropdown)",
  "slug": "select",
  "version": "1.0.0",
  "status": "stable",
  "category": "Form Controls",
  "description": "Dropdown pilihan opsi dari daftar panjang.",
  "figma": {
    "file": "Design System KAI v.1",
    "node": "124:4950"
  },
  "packages": {
    "blade": "kai/relux-ui",
