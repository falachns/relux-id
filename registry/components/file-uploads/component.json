{
  "$schema": "https://relux.kai.id/schema/component.json",
  "name": "File Upload",
  "slug": "file-uploads",
  "version": "1.0.0",
  "status": "stable",
  "category": "Application UI",
  "description": "Area unggah dokumen reservasi, identitas penumpang, dan lampiran dinas.",
  "figma": {
    "file": "Design System KAI v.1",
    "node": "124:5420"
  },
  "packages": {
    "blade": "kai/relux-ui",
    "react": "@kai/relux-react",
    "angular": "@kai/relux-angular",
    "css": "@kai/relux-css"
  },
  "dependencies": [
    "@kai/relux-css"
  ],
  "props": [
    {
      "name": "accept",
      "type": "string",
      "default": ".pdf,.png,.jpg"
    },
    {
      "name": "maxSizeMB",
      "type": "number",
      "default": "10"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "default": "true"
    }
  ],
  "variants": [
    "dropzone",
    "preview-list",
    "error"
  ]
}